{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-workflow-plugin/tasks.schema.json",
  "title": "SDD task board",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spec_id", "plan_ref", "tasks", "updated_at"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "spec_id": { "type": "string" },
    "plan_ref": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "description",
          "requirement_ids",
          "plan_item_ids",
          "files_to_change",
          "tests_to_add_or_update",
          "acceptance_criteria",
          "status",
          "evidence",
          "dependencies",
          "updated_at"
        ],
        "properties": {
          "task_id": { "type": "string", "pattern": "^T-\\d{3}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" }, "description": "Трассировка к требованиям спецификации." },
          "plan_item_ids": { "type": "array", "items": { "type": "string" } },
          "files_to_change": { "type": "array", "items": { "type": "string" } },
          "tests_to_add_or_update": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "description": "ID критериев приёмки спецификации." },
          "status": { "enum": ["todo", "in_progress", "blocked", "review", "done"] },
          "evidence": {
            "type": "array",
            "description": "Объективные доказательства: тесты, build, lint, type-check, ручная проверка.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference", "passed", "recorded_at"],
              "properties": {
                "kind": { "enum": ["test", "build", "lint", "typecheck", "integration", "manual"] },
                "reference": { "type": "string" },
                "passed": { "type": "boolean" },
                "recorded_at": { "type": "string", "format": "date-time" },
                "detail": { "type": "string" }
              }
            }
          },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
