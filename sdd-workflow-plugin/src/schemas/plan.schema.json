{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sdd-workflow-plugin/plan.schema.json",
  "title": "SDD technical plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "spec_id", "spec_version", "status", "codebase_analysis", "items", "generated_at"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "spec_id": { "type": "string" },
    "spec_version": { "type": "string" },
    "status": { "enum": ["draft", "approved"] },
    "codebase_analysis": { "type": "string", "description": "Анализ текущей кодовой базы, conventions и test setup." },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "description", "requirement_ids"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "description": "Относительный путь модуля/каталога." },
          "description": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "rationale", "requirement_ids"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description", "requirement_ids"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["api", "data"] },
          "description": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "description", "item_ids"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "item_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Пункты плана, каждый трассируем к requirement ID.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "requirement_ids", "files", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^P-\\d{3}$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "requirement_ids": { "type": "array", "items": { "type": "string" } },
          "files": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "risks_and_rollback": { "type": "string" },
    "readiness_criteria": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
