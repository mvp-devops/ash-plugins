{
  "name": "@local/doc-templates-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Шаблоны документации: панель в левой навигации Web UI DeepSeek Harness — CRUD шаблонов проектной документации, генерация документов из переменных, сохранение в <workspace>/docs/, импорт и экспорт.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./schema/*.json": "./schema/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "schema/*.json",
    "src/**/*.js",
    "tests/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-commands"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/"
  },
  "license": "MIT"
}
